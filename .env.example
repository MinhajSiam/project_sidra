# ============================================================
# SIDRA EVENT TICKETING PLATFORM — ENVIRONMENT CONFIGURATION
# ============================================================
# Duplicate this file as '.env' in your project root.
# Example: cp .env.example .env

# ------------------------------------------------------------
# 1. Application Settings
# ------------------------------------------------------------
APP_NAME="Sidra Event Ticketing Platform"
APP_ENV=production
# Set APP_DEBUG=false in production! NEVER set to true on live servers.
APP_DEBUG=false
# The full public URL of your platform (NO trailing slash)
APP_URL=https://ticketing.sidra.bd

# Application Encryption Key (Must be 32+ characters or base64 string)
# You can generate one via terminal: php -r "echo 'base64:' . base64_encode(random_bytes(32)) . PHP_EOL;"
APP_KEY=base64:7f9c2d1e8a4b6c3d5e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d

# ------------------------------------------------------------
# 2. Database Connection
# ------------------------------------------------------------
# Set DB_CONNECTION to 'mysql' for live production MySQL 8+ / MariaDB.
# Set DB_CONNECTION to 'sqlite' for zero-config testing / staging.
DB_CONNECTION=mysql

# MySQL Settings (Ignored if DB_CONNECTION=sqlite)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sidra_ticketing
DB_USERNAME=sidra_db_user
DB_PASSWORD=YourStrongDatabasePasswordHere!

# SQLite Settings (Used only if DB_CONNECTION=sqlite)
DB_SQLITE_PATH=storage/database/sidra.sqlite

# ------------------------------------------------------------
# 3. Security & Cryptographic Ticket Verification
# ------------------------------------------------------------
# Secret key used for signing QR code HMAC-SHA256 verification tokens.
# Keep this secret! Changing this invalidates previously issued QR passes.
TICKET_SECRET_KEY=s1dr4_s3cur3_v3r1f1c4t10n_k3y_98745230918237465192837465918237

# Session Lifetime in seconds (7200 = 2 hours)
SESSION_LIFETIME=7200

# Set to true when running under HTTPS/SSL in production
SESSION_SECURE_COOKIE=true

# ------------------------------------------------------------
# 4. Financial & Platform Defaults
# ------------------------------------------------------------
DEFAULT_CURRENCY=BDT
DEFAULT_CURRENCY_SYMBOL="৳"
MAX_TICKETS_PER_ORDER=10

# ------------------------------------------------------------
# 5. File Uploads
# ------------------------------------------------------------
# Maximum allowed file upload size in megabytes
MAX_UPLOAD_SIZE_MB=5
# Comma-separated allowed image extensions
ALLOWED_IMAGE_EXTENSIONS="jpg,jpeg,png,webp"

# ------------------------------------------------------------
# 6. Outgoing Mail / SMTP (Optional)
# ------------------------------------------------------------
# Used for system notifications and customer password reset emails.
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=support@sidra.bd
MAIL_FROM_NAME="Sidra Event Ticketing"
