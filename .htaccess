# Block direct access to sensitive file types (.env, .sql, .sqlite, .log, .lock, .json)
<FilesMatch "(^\.|\.(env|sql|sqlite|log|json|lock|md|sh|bak)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent directory listings
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to protected directories
    RewriteRule ^(app|database|storage|vendor|tests)(\/|$) - [F,L,NC]

    # Route all other traffic to the public/ directory
    RewriteRule ^$ public/ [L]
    RewriteRule (.*) public/$1 [L]
</IfModule>
