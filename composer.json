{
    "name": "sidra/event-ticketing-platform",
    "description": "Sidra Event Ticketing & Digital Verification Platform",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2.0",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "chillerlan/php-qrcode": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Core/Helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "migrate": "php database/migrate.php",
        "seed": "php database/migrate.php --seed",
        "serve": "php -S localhost:8000 -t public",
        "test": "php tests/run_tests.php"
    }
}
